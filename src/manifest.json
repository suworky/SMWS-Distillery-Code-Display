{
  "name": "SMWS Distillery Code Display",
  "description": "Displays distillery names for SMWS bottle codes on SMWS websites. / SMWSの蒸留所コードに蒸留所名を表示します。",
  "version": "1.1",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://smwsjapan.com/*",
        "https://smws.com/*",
        "https://smwsa.com/*"
      ],
      "js": ["distilleries.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
