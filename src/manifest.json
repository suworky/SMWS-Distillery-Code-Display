{
  "name": "SMWS Distillery Code Display",
  "description": "SMWSの蒸留所コードを蒸留所名に変換して表示する拡張機能です。対応サイトは、smwsjapan.com、smws.com、smwsa.comです。 / This extension converts SMWS distillery codes to distillery names and displays them. Supported sites are smwsjapan.com, smws.com, smwsa.com.",
  "version": "1.2.0",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://smwsjapan.com/*",
        "https://smws.com/*",
        "https://smwsa.com/*"
      ],
      "js": ["distilleries.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
