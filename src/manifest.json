{
  "name": "SMWS Distillery Code Display",
  "description": "SMWS各サイトの蒸留所コードを蒸留所名に変換表示します（Japan/UK/USA/EU対応） / Converts distillery codes to names on all SMWS sites (JP/UK/USA/EU)",
  "version": "1.3.0",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://smwsjapan.com/*",
        "https://smws.com/*",
        "https://smwsa.com/*",
        "https://smws.eu/*"
      ],
      "js": ["distilleries.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
